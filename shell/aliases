# shellcheck shell=bash
# 共有エイリアス。dotfilesで管理する。
# Ubuntu標準の ~/.bashrc が ~/.bash_aliases を自動でsourceするため、
# このファイルを ~/.bash_aliases にリンクするだけで読み込まれる。
#
# ホストでしか使わないエイリアス(devcontainer操作など)は devc/aliases に置き、
# マシン固有のエイリアスは aliases.local (雛形から生成・gitには含めない) に書く。
# どちらもこのファイルの末尾でsourceする。

# --- git ---
alias g='git'
alias gs='git status'
alias gd='git diff'
alias gl='git log --oneline --graph --decorate'
alias gc='git commit'
alias gco='git checkout'
alias gb='git branch'

# devcontainer 内では GitHub のトークンをディスクに置かず credential cache
# (メモリ常駐)にだけ持たせている。gh は GH_TOKEN を読むので、呼び出しのたびに
# cache から取り出して渡す。config.auth があるとき = コンテナ側なので、ホストの
# gh(ログイン済み)には影響しない。
if [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/git/config.auth" ]; then
  function gh() {
    local token
    # cache が空でも対話プロンプトに落ちないよう GIT_TERMINAL_PROMPT=0 で抑止する
    token="$(printf 'protocol=https\nhost=github.com\n\n' |
      GIT_TERMINAL_PROMPT=0 git credential fill 2>/dev/null |
      sed -n 's/^password=//p')"
    if [ -n "$token" ]; then
      GH_TOKEN="$token" command gh "$@"
    else
      echo "gh: credential cache にトークンがありません(期限切れ?)。ホスト側で devcauth を実行してください。" >&2
      command gh "$@"
    fi
  }
fi

# --- ファイル操作 ---
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias ..='cd ..'
alias ...='cd ../..'

# --- ホスト専用エイリアスを読み込む(あれば) ---
# devc/install.sh が ~/.config/shell/aliases.host としてリンクする。
# devcontainer内では install-local.sh を通らないので存在せず、読み込まれない。
_aliases_host="${XDG_CONFIG_HOME:-$HOME/.config}/shell/aliases.host"
[ -f "$_aliases_host" ] && . "$_aliases_host"
unset _aliases_host

# --- マシン固有エイリアスを読み込む(あれば) ---
_aliases_local="${XDG_CONFIG_HOME:-$HOME/.config}/shell/aliases.local"
[ -f "$_aliases_local" ] && . "$_aliases_local"
unset _aliases_local
