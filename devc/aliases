# shellcheck shell=bash
# devcontainerを操作するためのホスト専用エイリアス。コンテナ内では使わない。
#
# devc/install.sh が ~/.config/shell/aliases.host としてリンクし、
# shell/aliases が末尾でsourceする。コンテナ内にはこのファイルが無いので読み込まれない。

# --- devcontainer ---
# devcontainer を起動する。dotfiles に加えて git の認証情報も渡す:
#   - GH_TOKEN  : gh のトークン。--secrets-file 経由で渡してコマンドライン(ps)に出さない。
#   - GIT_USER_EMAIL : ホストの user.email。コンテナ側の config.local に埋める。
# 受け取り側は git/install.sh(dotfiles install 時に実行される)。
function devcu() {
  local secrets token email status
  local -a opts=()

  email="$(git config --get user.email 2>/dev/null)"
  [ -n "$email" ] && opts+=(--remote-env "GIT_USER_EMAIL=${email}")

  # コンテナ内の gh を hosts.yml にログインさせたい場合のみ(通常は gh ラッパーで足りる)
  [ -n "${DOTFILES_GH_LOGIN:-}" ] && opts+=(--remote-env "DOTFILES_GH_LOGIN=1")

  token="$(gh auth token 2>/dev/null)"
  if [ -n "$token" ]; then
    secrets="$(mktemp)"
    chmod 600 "$secrets"
    printf '{"GH_TOKEN":"%s"}\n' "$token" >"$secrets"
    opts+=(--secrets-file "$secrets")
  else
    echo "devcu: gh のトークンを取得できません(gh auth login 済みか確認)。git 認証なしで起動します。" >&2
  fi

  devcontainer up \
    --dotfiles-repository https://github.com/aobatact/dotfiles.git \
    --dotfiles-install-command install-devcontainer.sh \
    "${opts[@]}" \
    "$@"
  status=$?

  [ -n "${secrets:-}" ] && rm -f "$secrets"
  return $status
}
# 起動済みコンテナの git 認証を張り直す(トークン失効時や、後から gh でログインし直した時)。
# exec には --secrets-file が無いため --remote-env で渡す(ホストの ps に一瞬トークンが見える)。
function devcauth() {
  local token
  token="$(gh auth token 2>/dev/null)"
  [ -z "$token" ] && { echo "devcauth: gh のトークンを取得できません" >&2; return 1; }
  devcontainer exec --remote-env "GH_TOKEN=${token}" "$@" bash -c 'bash "$HOME/dotfiles/git/install.sh"'
}
function devce() {
  devcontainer exec "$@"
}
function devcs() {
  local ids
  ids=$(docker ps -q --filter "label=devcontainer.local_folder=$(pwd)")
  [ -z "$ids" ] && { echo "停止対象の devcontainer がありません"; return 0; }
  docker stop $ids
}
function devcd() {
  local ids
  ids=$(docker ps -q -a --filter "label=devcontainer.local_folder=$(pwd)")
  [ -z "$ids" ] && { echo "停止対象の devcontainer がありません"; return 0; }
  docker rm -f $ids
}

# --- herdr: コンテナ内のエージェントをホスト側herdrに検知させる ---
# herdrはペインのフォアグラウンドプロセスからエージェント種別を判定するが、
# devcontainer越しだと `devcontainer exec` しか見えずclaudeだと分からない。
# HERDR_AGENT でヒントを与えると既存の画面判定ルール(manifest)が適用され、
# idle/working/blocked の判定が動く。画面出力自体はdocker exec越しでもそのまま流れる。
#
# ヒントはそのフォアグラウンドプロセスにスコープされるため、
# コンテナ内で設定しても herdr からは見えない。必ずホスト側で付ける。
# 判定結果は `herdr agent explain <pane>` で確認できる。
function devca() {
  if [ $# -eq 0 ]; then
    echo "usage: devca <agent> [args...]   例: devca claude / devca codex" >&2
    return 1
  fi
  local agent="$1"
  shift
  HERDR_AGENT="$agent" devcontainer exec "$agent" "$@"
}
function devcc() {
  devca claude "$@"
}
